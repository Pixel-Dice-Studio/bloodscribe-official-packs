      "info": {
        "name": "Centro de la mesa",
        "ability": "Según el número de jugadores, el Narrador deja visibles personajes del cuento que no están en juego.",
        "howToRun": "Después de cerrar la bolsa, deja en el centro 4 personajes con 7 jugadores, 3 con 8, 2 con 9 y 1 con 10. No dejes ninguno con otra cantidad."
      },
      "rules": {
        "setup": true,
        "cues": [],
