    {
      "entityKind": "gameRule",
      "id": "rule:bloodscribe:setup:evil-core-learns-bluffs",
      "visibility": "public",
      "ruleKind": "setup",
      "systemType": "setup",
      "categoryId": "rule-category:common:setup",
      "category": {
        "id": "rule-category:common:setup",
        "terms": {
          "singular": "Preparación",
          "plural": "Preparaciones"
        },
        "description": "Reglas opcionales que modifican la preparación de cualquier cuento."
      },
      "activationTags": [
        "startingInformation:mainEvilBluffs"
      ],
      "info": {
        "name": "Faroles para el Mal",
        "ability": "En la primera noche, cada personaje principal alineado con el Mal conoce 3 personajes que no están en juego.",
        "howToRun": "Durante la preparación, elige 3 personajes buenos que no estén en juego. En la primera noche, despierta por separado a cada personaje principal del Mal y muéstrale los tres faroles."
      },
      "rules": {
        "wake": {
          "first": true,
          "other": false,
          "firstOrder": 235
        },
        "setup": true,
        "cues": [],
        "mechanics": [
          {
            "mechanicId": "mechanic:bloodscribe:setup:evil-core-learns-bluffs:information",
            "tags": [
              "information",
              "starting-information"
            ],
            "when": {
              "window": "firstNight",
              "cadence": "once",
              "startsAt": 1
            },
            "conditions": [],
            "effects": [
              {
                "type": "emitInformation",
                "value": {
                  "type": "object",
                  "entries": {
                    "bluffs": {
                      "type": "setup",
                      "property": "mainEvilBluffCharacterIds"
                    }
                  }
                },
                "presentation": {
                  "kind": "structured",
                  "title": "Faroles preparados durante la preparación",
                  "fields": [
                    {
                      "key": "bluffs",
                      "label": "Personajes que no están en juego",
                      "kind": "characters",
                      "required": true,
                      "min": 3,
                      "max": 3
                    }
                  ]
                },
                "delivery": {
                  "audience": {
                    "type": "players",
                    "value": {
                      "type": "query",
                      "from": {
                        "entity": "players"
                      },
                      "where": {
                        "type": "all",
                        "conditions": [
                          {
                            "type": "identity",
                            "identityMode": "registered",
                            "facet": "allegiance",
                            "values": [
                              "evil"
                            ]
                          },
                          {
                            "type": "identity",
                            "identityMode": "registered",
                            "facet": "role",
                            "values": [
                              "core"
                            ]
                          }
                        ]
                      },
                      "aggregate": {
                        "type": "collect"
                      },
                      "project": {
                        "type": "entityId"
                      }
                    }
                  },
                  "mode": "perRecipient"
                }
              }
            ],
            "presentation": {
              "nightGuide": {
                "action": [
                  "Despierta por separado a cada personaje principal del Mal."
                ],
                "communicate": [
                  "Muéstrale los tres personajes que no están en juego preparados como faroles."
                ],
                "checks": [
                  "Comprueba que estás mostrando los faroles elegidos durante la preparación."
                ]
              }
            }
          }
        ]
      },
      "links": [],
      "bookIds": []
    },
