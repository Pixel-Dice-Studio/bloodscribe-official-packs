      "defaultAlignment": "good",
      "edition": "grimm-hansel-gretel",
      "text": {
        "name": "Hansel",
        "ability": "Each night, choose another player. If an abandonment, poison, or death ability targets them, learn the faction of one source.",
        "summary": "Tracks hostile abilities with moonlit pebbles.",
        "flavor": "White stones shine in the moonlight and show the way home."
      },
      "wiki": {
        "firstNight": "Hansel chooses another player and marks them with a White Pebble.",
        "otherNight": "Hansel chooses another player and receives any pending source-faction information at dawn.",
        "notes": [
          "The Storyteller chooses one source if several observed abilities target the marked player."
        ]
      },
      "rules": {
        "wake": {
          "first": true,
          "other": true,
          "firstOrder": 12,
          "otherOrder": 12
        },
        "setup": false,
        "reminderTokens": [
