      "info": {
        "name": "Standard game end",
        "ability": "Good wins when no Demon remains alive. Evil wins when at most two players remain alive; Travellers and Storyteller rules do not count. If both conditions happen at once, good wins. The Storyteller may declare a mathematically inevitable victory early."
      },
      "rules": {
        "setup": false,
        "cues": [],
        "mechanics": [
          {
            "mechanicId": "mechanic:grimm:common-game-end:resolve",
            "tags": [
              "win-condition",
              "game-end-policy"
            ],
            "when": {
              "window": "gameEnd",
              "cadence": "each"
            },
            "conditions": [
              {
                "type": "any",
                "conditions": [
                  {
                    "type": "all",
                    "conditions": [
                      {
                        "type": "query",
                        "from": {
                          "entity": "players"
                        },
                        "where": {
                          "type": "all",
                          "conditions": [
                            {
                              "type": "identity",
                              "identityMode": "initial",
                              "facet": "role",
                              "values": [
                                "core"
                              ]
                            },
                            {
                              "type": "identity",
                              "identityMode": "initial",
                              "facet": "allegiance",
                              "values": [
                                "evil"
                              ]
                            }
                          ]
                        },
                        "aggregate": {
                          "type": "exists"
                        }
                      },
                      {
                        "type": "compare",
                        "left": {
                          "type": "query",
                          "from": {
                            "entity": "players"
                          },
                          "where": {
                            "type": "all",
                            "conditions": [
                              {
                                "type": "alive",
                                "value": true
                              },
                              {
                                "type": "identity",
                                "identityMode": "base",
                                "facet": "role",
                                "values": [
                                  "core"
                                ]
                              },
                              {
                                "type": "identity",
                                "identityMode": "base",
                                "facet": "allegiance",
                                "values": [
                                  "evil"
                                ]
                              }
                            ]
                          },
                          "aggregate": {
                            "type": "count"
                          }
                        },
                        "operator": "eq",
                        "right": 0
                      }
                    ]
                  },
                  {
                    "type": "compare",
                    "left": {
                      "type": "query",
                      "from": {
                        "entity": "players"
                      },
                      "where": {
                        "type": "all",
                        "conditions": [
                          {
                            "type": "alive",
                            "value": true
                          },
                          {
                            "type": "assignment",
                            "values": [
                              "player"
                            ]
                          }
                        ]
                      },
                      "aggregate": {
                        "type": "count"
                      }
                    },
                    "operator": "lte",
                    "right": 2
                  }
                ]
              }
            ],
            "effects": [
              {
                "type": "resolveGameEnd",
                "mode": "immediate",
                "winner": {
                  "type": "condition",
                  "cases": [
                    {
                      "when": {
                        "type": "all",
                        "conditions": [
                          {
                            "type": "query",
                            "from": {
                              "entity": "players"
                            },
                            "where": {
                              "type": "all",
                              "conditions": [
                                {
                                  "type": "identity",
                                  "identityMode": "initial",
                                  "facet": "role",
                                  "values": [
                                    "core"
                                  ]
                                },
                                {
                                  "type": "identity",
                                  "identityMode": "initial",
                                  "facet": "allegiance",
                                  "values": [
                                    "evil"
                                  ]
                                }
                              ]
                            },
                            "aggregate": {
                              "type": "exists"
                            }
                          },
                          {
                            "type": "compare",
                            "left": {
                              "type": "query",
                              "from": {
                                "entity": "players"
                              },
                              "where": {
                                "type": "all",
                                "conditions": [
                                  {
                                    "type": "alive",
                                    "value": true
                                  },
                                  {
                                    "type": "identity",
                                    "identityMode": "base",
                                    "facet": "role",
                                    "values": [
                                      "core"
                                    ]
                                  },
                                  {
                                    "type": "identity",
                                    "identityMode": "base",
                                    "facet": "allegiance",
                                    "values": [
                                      "evil"
                                    ]
                                  }
                                ]
                              },
                              "aggregate": {
                                "type": "count"
                              }
                            },
                            "operator": "eq",
                            "right": 0
                          }
                        ]
                      },
                      "winner": {
                        "type": "fixed",
                        "team": "good"
                      }
                    }
                  ],
                  "otherwise": {
                    "type": "fixed",
                    "team": "evil"
                  }
                },
                "reason": "Se cumplieron las condiciones estándar de final de partida."
              }
            ]
          },
          {
            "mechanicId": "mechanic:grimm:common-game-end:storyteller-execution",
            "tags": [
              "loss-condition",
              "game-end-policy"
            ],
            "when": {
              "window": "execution",
              "cadence": "each",
              "trigger": {
                "type": "event",
                "event": "storytellerExecution"
              }
            },
            "conditions": [],
            "effects": [
              {
                "type": "resolveGameEnd",
                "mode": "immediate",
                "winner": {
                  "type": "fixed",
                  "team": "evil"
                },
                "reason": "El Narrador fue ejecutado sin una regla activa que conceda la victoria al bien."
              }
            ]
          }
        ]
      },
