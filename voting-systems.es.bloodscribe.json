          "maxPerNominatorPerDay": 1,
          "maxPerNomineePerDay": 1
        },
        "candidates": {
          "source": "nominated",
          "lifeState": "any"
        },
        "ballot": {
          "shape": "approvalPerNominee",
          "enteredBy": "storyteller",
          "pace": "seatOrder",
          "reveal": "live",
          "visibility": "public",
          "electorate": {
            "kind": "standard",
            "lastBreathsPerPlayer": 1
          },
          "abstention": "allowed",
          "order": {
            "start": "afterNominee",
            "direction": "clockwise"
          }
        },
        "resolution": {
          "threshold": {
            "kind": "fraction",
            "base": "livingPlayers",
            "numerator": 1,
            "denominator": 2,
            "comparison": "atLeast"
          },
          "winner": "highest",
          "onTie": {
            "kind": "spareAll"
          },
          "onNoQualifier": {
            "kind": "spareAll"
          }
        },
        "timing": {
          "open": "perNomination",
          "resolve": "dusk"
        },
        "disclosure": {
          "publicResult": "totals"
        }
